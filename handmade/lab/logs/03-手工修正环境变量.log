# OpenSSL 3.2.1 环境变量（手工修正：库目录是 lib64，不是 lib）
export PATH="$HOME/rocopenssl_build/bin:$PATH"
export LD_LIBRARY_PATH="$HOME/rocopenssl_build/lib64:$LD_LIBRARY_PATH"
export PKG_CONFIG_PATH="$HOME/rocopenssl_build/lib64/pkgconfig:$PKG_CONFIG_PATH"
